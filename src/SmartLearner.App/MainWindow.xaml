<Window x:Class="SmartLearner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Smart Learner"
        Icon="Assets/app.ico"
        Height="840"
        Width="1320"
        MinHeight="520"
        MinWidth="900"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{DynamicResource BodyFont}"
        FocusManager.FocusedElement="{Binding ElementName=NavList}"
        TextElement.Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 底纹：暖色渐变 + 纸纹 -->
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource WindowWashBrush}" />
        <Rectangle Grid.RowSpan="2" Opacity="0.22" IsHitTestVisible="False">
            <Rectangle.Fill>
                <ImageBrush ImageSource="pack://application:,,,/SmartLearner.App;component/Assets/paper-grain.png"
                            TileMode="Tile"
                            Viewport="0,0,256,256"
                            ViewportUnits="Absolute" />
            </Rectangle.Fill>
        </Rectangle>

        <!-- 顶栏 -->
        <Border Grid.Row="0"
                x:Name="HeaderBar"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="9"
                            Background="{DynamicResource AccentBrush}">
                        <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                 Width="21"
                                                 Height="21"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Smart Learner"
                               Margin="12,0,0,0"
                               FontFamily="{DynamicResource HeadingFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="学而时习之"
                               Margin="12,1,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SubtleBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="12"
                            Padding="12,5"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#B0453A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="#3F8F5B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding NetworkText}"
                                       Margin="7,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Text="·" Margin="7,0" FontSize="12" Foreground="{DynamicResource SubtleBrush}" />
                            <TextBlock Text="{Binding SecretText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource MossSoftBrush}"
                            CornerRadius="12"
                            Padding="12,5"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#B0453A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BailianOnline}" Value="True">
                                                <Setter Property="Fill" Value="#C08A2E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding BailianText}"
                                       Margin="7,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="切换明暗主题">
                        <materialDesign:PackIcon Kind="{Binding ThemeIcon}"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource InkBrush}" />
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="设置">
                        <materialDesign:PackIcon Kind="CogOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource InkBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    x:Name="SidebarBar"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             x:Name="NavList"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,10,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding Icon}"
                                                             Width="19"
                                                             Height="19"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}"
                                               Margin="12,0,0,0"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Image Grid.Row="1"
                           Source="pack://application:,,,/SmartLearner.App;component/Assets/hero-botanical.png"
                           Height="132"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Right"
                           Opacity="0.38"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="ContentHost" Margin="26,22,26,22">
                <ContentControl Content="{Binding HomePage}"
                                Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}" />
                <ContentControl Content="{Binding CoursePage}"
                                Visibility="{Binding IsCoursePage, Converter={StaticResource BoolToVis}}" />
                <ContentControl Content="{Binding OrganizePage}"
                                Visibility="{Binding IsOrganizePage, Converter={StaticResource BoolToVis}}" />
                <ContentControl Content="{Binding SettingsPage}"
                                Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
