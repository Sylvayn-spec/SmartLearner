<UserControl x:Class="SmartLearner.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{DynamicResource BodyFont}">

    <UserControl.Resources>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />

        <!-- 知乎文章卡片 -->
        <DataTemplate x:Key="ArticleCard">
            <Button Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    Focusable="False"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,0,0,8">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,11">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="{Binding Summary}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               MaxHeight="34"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding MetaText}"
                               Margin="0,6,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource SubtleBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <SineEase x:Key="EaseInOut" EasingMode="EaseInOut" />

        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="HeroCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="HeroShift"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.55"
                             EasingFunction="{StaticResource EaseOut}" />

            <DoubleAnimation Storyboard.TargetName="Tile1"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="Tile1Shift"
                             Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.5" BeginTime="0:0:0.10"
                             EasingFunction="{StaticResource EaseOut}" />

            <DoubleAnimation Storyboard.TargetName="Tile2"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="Tile2Shift"
                             Storyboard.TargetProperty="Y"
                             From="14" To="0" Duration="0:0:0.5" BeginTime="0:0:0.18"
                             EasingFunction="{StaticResource EaseOut}" />

            <DoubleAnimation Storyboard.TargetName="CourseCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.32" />
            <DoubleAnimation Storyboard.TargetName="CourseShift"
                             Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.55" BeginTime="0:0:0.32"
                             EasingFunction="{StaticResource EaseOut}" />

            <DoubleAnimation Storyboard.TargetName="PushCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.40" />
            <DoubleAnimation Storyboard.TargetName="PushShift"
                             Storyboard.TargetProperty="Y"
                             From="16" To="0" Duration="0:0:0.55" BeginTime="0:0:0.40"
                             EasingFunction="{StaticResource EaseOut}" />
        </Storyboard>

        <Storyboard x:Key="FloatStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LeafShift"
                             Storyboard.TargetProperty="Y"
                             From="-5" To="5" Duration="0:0:7"
                             EasingFunction="{StaticResource EaseInOut}" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource EntranceStoryboard}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FloatStoryboard}" />
            </EventTrigger>
        </Grid.Triggers>

        <ScrollViewer x:Name="PageScroll"
                      VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- 主视觉 -->
                <Border x:Name="HeroCard"
                        Style="{StaticResource GlassCardStyle}"
                        Height="196"
                        Margin="0,0,0,16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="HeroShift" />
                    </Border.RenderTransform>
                    <Grid ClipToBounds="True">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#33E3ECDC" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Image Source="pack://application:,,,/SmartLearner.App;component/Assets/hero-botanical.png"
                               Width="430"
                               Stretch="Uniform"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,-8,-26"
                               Opacity="0.95"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="LeafShift" />
                            </Image.RenderTransform>
                        </Image>

                        <StackPanel Margin="34,0,0,0"
                                    VerticalAlignment="Center"
                                    MaxWidth="300"
                                    HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="今日"
                                           FontFamily="{DynamicResource HeadingFont}"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <Border Background="{DynamicResource MossSoftBrush}"
                                        CornerRadius="14"
                                        Padding="12,5"
                                        Margin="14,0,0,6"
                                        VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarToday"
                                                                 Width="14" Height="14"
                                                                 Foreground="{DynamicResource MossBrush}"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DateText}"
                                                   Margin="6,0,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource InkSoftBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding LunarText}"
                                       Margin="4,12,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleBrush}" />

                            <TextBlock Text="窗边有绿，案头有书。课表与热榜，一屏看完。"
                                       Margin="4,8,0,0"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkSoftBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 两块概览 -->
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <Border x:Name="Tile1"
                            Style="{StaticResource LiftCardStyle}"
                            Margin="0,0,5,0"
                            Padding="16,14"
                            Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Tile1Shift" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19"
                                    Background="{DynamicResource MossSoftBrush}">
                                <materialDesign:PackIcon Kind="BookOpenVariant"
                                                         Width="19" Height="19"
                                                         Foreground="{DynamicResource MossBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CourseCountText}"
                                           FontFamily="{DynamicResource HeadingFont}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="课程总数"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="Tile2"
                            Style="{StaticResource LiftCardStyle}"
                            Margin="5,0,0,0"
                            Padding="16,14"
                            Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Tile2Shift" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <materialDesign:PackIcon Kind="TagMultipleOutline"
                                                         Width="19" Height="19"
                                                         Foreground="{DynamicResource GoldBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KeywordCountText}"
                                           FontFamily="{DynamicResource HeadingFont}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="关注关键词"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 今日课程 -->
                <Border x:Name="CourseCard"
                        Style="{StaticResource LiftCardStyle}"
                        Margin="0,0,0,16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CourseShift" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="18,0,0,18" />

                        <StackPanel Grid.Column="1" Margin="22,20,22,22">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SchoolOutline"
                                                             Width="18" Height="18"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="今日课程"
                                               Margin="8,0,0,0"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource InkButton}" DockPanel.Dock="Right"
                                        Content="{Binding CourseActionText}"
                                        FontSize="12"
                                        Padding="14,6"
                                        Click="OnCourseActionClick" />
                            </DockPanel>

                            <!-- 空状态：还没有任何课程 -->
                            <Border Margin="0,18,0,0"
                                    Padding="28,30"
                                    CornerRadius="12"
                                    Background="{DynamicResource MossSoftBrush}"
                                    Visibility="{Binding EmptyStateVisibility}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarBlankOutline"
                                                             Width="34" Height="34"
                                                             Foreground="{DynamicResource MossBrush}"
                                                             HorizontalAlignment="Center" />
                                    <TextBlock Text="添加课程信息以解锁课表提醒功能"
                                               Margin="0,12,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="点击右上角「添加课程」开始记录你的课表"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 有课程，但今天没课 -->
                            <Border Margin="0,18,0,0"
                                    Padding="28,30"
                                    CornerRadius="12"
                                    Background="{DynamicResource MossSoftBrush}"
                                    Visibility="{Binding NoClassVisibility}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="WeatherSunny"
                                                             Width="34" Height="34"
                                                             Foreground="{DynamicResource GoldBrush}"
                                                             HorizontalAlignment="Center" />
                                    <TextBlock Text="今日无课"
                                               Margin="0,12,0,0"
                                               FontFamily="{DynamicResource HeadingFont}"
                                               FontSize="18"
                                               Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="适合整理笔记，或去「课程」里补一份课件"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 今日课程列表 -->
                            <ItemsControl ItemsSource="{Binding TodayCourses}"
                                          Visibility="{Binding ListVisibility}"
                                          Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MossSoftBrush}"
                                                CornerRadius="12"
                                                Padding="16,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Background="{DynamicResource MossBrush}"
                                                        CornerRadius="8"
                                                        Padding="10,6"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TimeText}"
                                                               Foreground="White"
                                                               FontSize="12" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Margin="14,0"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DayText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SubtleBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 知乎推送 -->
                <Border x:Name="PushCard"
                        Style="{StaticResource LiftCardStyle}"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PushShift" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource MossBrush}"
                                CornerRadius="18,0,0,18" />

                        <StackPanel Grid.Column="1" Margin="22,20,22,22">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Fire"
                                                         Width="18" Height="18"
                                                         Foreground="{DynamicResource GoldBrush}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="知乎推送"
                                           Margin="8,0,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                            </StackPanel>

                            <TabControl Margin="0,14,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        SelectedIndex="{Binding ZhihuTabIndex}">
                                <TabItem Header="今日热榜">
                                    <StackPanel Margin="0,12,0,0">
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="重新拉取热榜"
                                                    Command="{Binding RefreshZhihuNowCommand}">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="16" Height="16"
                                                                         Foreground="{DynamicResource SubtleBrush}" />
                                            </Button>
                                            <TextBlock Text="{Binding ZhihuStatusText}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <!-- 未配置 -->
                                        <Border Padding="26,30"
                                                CornerRadius="12"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Visibility="{Binding ZhihuUnconfiguredVisibility}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Fire"
                                                                         Width="30" Height="30"
                                                                         Foreground="{DynamicResource GoldBrush}"
                                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="配置知乎 Access Key 后解锁热榜"
                                                           Margin="0,12,0,0"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="在「设置」中填入开放平台个人中心的 Access Key"
                                                           Margin="0,6,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SubtleBrush}"
                                                           HorizontalAlignment="Center" />
                                                <Button Style="{StaticResource InkButton}" Content="去设置"
                                                        Margin="0,16,0,0"
                                                        HorizontalAlignment="Center"
                                                        Padding="20,8"
                                                        Click="OnOpenSettingsClick" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 过期提示 -->
                                        <Border Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,0,10"
                                                Visibility="{Binding ZhihuExpiredVisibility}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource InkButton}"
                                                        Content="去设置"
                                                        FontSize="11"
                                                        Padding="12,5"
                                                        Click="OnOpenSettingsClick" />
                                                <StackPanel>
                                                    <TextBlock Text="Access Key 已过期"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="下面显示的是本周缓存，建议更新 Key"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SubtleBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding HotArticles}"
                                                      ItemTemplate="{StaticResource ArticleCard}"
                                                      Visibility="{Binding HotVisibility}" />

                                        <TextBlock Text="暂无相关内容"
                                                   Margin="0,14,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding HotEmptyVisibility}" />

                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="我的关注">
                                    <StackPanel Margin="0,12,0,0">
                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="重新拉取关注内容"
                                                    Command="{Binding RefreshZhihuNowCommand}">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="16" Height="16"
                                                                         Foreground="{DynamicResource SubtleBrush}" />
                                            </Button>
                                            <TextBlock Text="关键词订阅"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubtleBrush}" />
                                        </DockPanel>
                                        <Border Padding="26,30"
                                                CornerRadius="12"
                                                Background="{DynamicResource MossSoftBrush}"
                                                Visibility="{Binding ZhihuUnconfiguredVisibility}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="TagMultipleOutline"
                                                                         Width="30" Height="30"
                                                                         Foreground="{DynamicResource MossBrush}"
                                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="配置知乎 Access Key 后解锁关键词订阅"
                                                           Margin="0,12,0,0"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="最多 6 个关键词，每个关键词取 3 条近七天内容"
                                                           Margin="0,6,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SubtleBrush}"
                                                           HorizontalAlignment="Center" />
                                                <Button Style="{StaticResource InkButton}" Content="去设置"
                                                        Margin="0,16,0,0"
                                                        HorizontalAlignment="Center"
                                                        Padding="20,8"
                                                        Click="OnOpenSettingsClick" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Visibility="{Binding IsZhihuConfigured, Converter={StaticResource BoolToVis}}">

                                            <!-- 偏好标签 -->
                                            <DockPanel Margin="0,0,0,4"
                                                       LastChildFill="True"
                                                       Visibility="{Binding PreferenceListVisibility}">
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource GhostButton}"
                                                        Content="添加偏好"
                                                        FontSize="11"
                                                        Padding="12,5"
                                                        Margin="10,0,0,8"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding AddPreferenceCommand}" />

                                                <ItemsControl ItemsSource="{Binding Preferences}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource MossSoftBrush}"
                                                                    CornerRadius="14"
                                                                    Padding="12,6"
                                                                    Margin="0,0,8,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource InkBrush}" />
                                                                    <Button Margin="8,0,0,0"
                                                                            CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.RemovePreferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Width" Value="16" />
                                                                                <Setter Property="Height" Value="16" />
                                                                                <Setter Property="MinHeight" Value="0" />
                                                                                <Setter Property="Padding" Value="0" />
                                                                                <Setter Property="Background" Value="Transparent" />
                                                                                <Setter Property="BorderThickness" Value="0" />
                                                                                <Setter Property="Cursor" Value="Hand" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                                                                                <Setter Property="ToolTip" Value="删除这个偏好" />
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Border Background="Transparent" CornerRadius="8">
                                                                                                <TextBlock Text="✕"
                                                                                                           FontSize="9"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center"
                                                                                                           Foreground="{TemplateBinding Foreground}" />
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>

                                            <!-- 没有偏好 -->
                                            <Border Padding="26,30"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource MossSoftBrush}"
                                                    Visibility="{Binding PreferenceEmptyVisibility}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="TagMultipleOutline"
                                                                             Width="30" Height="30"
                                                                             Foreground="{DynamicResource MossBrush}"
                                                                             HorizontalAlignment="Center" />
                                                    <TextBlock Text="还未添加推送偏好"
                                                               Margin="0,12,0,0"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="添加关键词后，会按关键词拉取近七天的知乎内容"
                                                               Margin="0,6,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SubtleBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <Button Style="{StaticResource InkButton}"
                                                            Content="添加偏好"
                                                            Margin="0,16,0,0"
                                                            HorizontalAlignment="Center"
                                                            Padding="20,8"
                                                            Command="{Binding AddPreferenceCommand}" />
                                                </StackPanel>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding KeywordArticles}"
                                                          ItemTemplate="{StaticResource ArticleCard}"
                                                          Visibility="{Binding KeywordVisibility}" />

                                            <TextBlock Text="暂无相关内容"
                                                       Margin="0,14,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding KeywordEmptyVisibility}" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
