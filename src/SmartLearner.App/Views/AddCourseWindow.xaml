<Window x:Class="SmartLearner.App.Views.AddCourseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="添加课程"
        Height="480"
        Width="600"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{DynamicResource BodyFont}"
        TextElement.Foreground="{DynamicResource InkBrush}">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding HeaderText}"
                       FontFamily="{DynamicResource HeadingFont}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="填写课程名、星期与上课时间；时间可以重叠，课程名不可重复"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SubtleBrush}" />
        </StackPanel>

        <!-- 课程行 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}"
                                    Padding="16,14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource GhostButton}"
                                                Content="删除"
                                                FontSize="11"
                                                Padding="10,5"
                                                Margin="10,0,0,0"
                                                Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="课程名，例如：高等数学"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 FontSize="14"
                                                 VerticalAlignment="Center" />
                                    </DockPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding DataContext.DayOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Day}"
                                                  materialDesign:HintAssist.Hint="星期"
                                                  materialDesign:HintAssist.IsFloating="True"
                                                  FontSize="13" />

                                        <ComboBox Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Start}"
                                                  materialDesign:HintAssist.Hint="开始"
                                                  materialDesign:HintAssist.IsFloating="True"
                                                  FontSize="13" />

                                        <TextBlock Grid.Column="2"
                                                   Text="至"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubtleBrush}" />

                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding End}"
                                                  materialDesign:HintAssist.Hint="结束"
                                                  materialDesign:HintAssist.IsFloating="True"
                                                  FontSize="13" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource GhostButton}"
                        Content="+ 添加另一门课程"
                        HorizontalAlignment="Left"
                        Padding="14,7"
                        Visibility="{Binding AddRowVisibility}"
                        Command="{Binding AddRowCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 错误提示 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap" />

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="取消"
                    Width="88"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource InkButton}"
                    Content="确认"
                    Width="96"
                    Margin="10,0,0,0"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
