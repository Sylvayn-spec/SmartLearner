<Window x:Class="SmartLearner.App.Views.ManageChatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="管理对话"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBrush}"
        FontFamily="{DynamicResource BodyFont}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="管理对话"
                       FontFamily="{DynamicResource HeadingFont}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="勾选要删除的对话，删除后本地记录和对话 ID 一并移除"
                       Margin="0,6,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SubtleBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Style="{StaticResource GlassCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Margin="0,4"
                                      VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               Foreground="{DynamicResource InkBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                               Margin="10,0,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource SubtleBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource GhostButton}"
                    Content="全选"
                    FontSize="12"
                    Padding="12,6"
                    Click="OnSelectAllClick" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource InkButton}"
                    Content="删除选中"
                    FontSize="12"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    Click="OnDeleteClick" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    Content="取消"
                    FontSize="12"
                    Padding="14,6"
                    Click="OnCancelClick" />
        </DockPanel>
    </Grid>
</Window>
