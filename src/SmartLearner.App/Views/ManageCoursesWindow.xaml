<Window x:Class="SmartLearner.App.Views.ManageCoursesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="课程管理"
        Height="600"
        Width="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{DynamicResource BodyFont}"
        TextElement.Foreground="{DynamicResource InkBrush}">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="课程管理"
                       FontFamily="{DynamicResource HeadingFont}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock x:Name="CountText"
                       Text="共 0 门课程"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SubtleBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="CourseList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCardStyle}"
                                Padding="16,12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource MossSoftBrush}"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource InkBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <TextBlock Text="{Binding DayText}"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SubtleBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Content="编辑"
                                        FontSize="12"
                                        Padding="12,5"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Click="OnEditClick" />

                                <Button Grid.Column="3"
                                        Style="{StaticResource GhostButton}"
                                        Content="删除"
                                        FontSize="12"
                                        Padding="12,5"
                                        VerticalAlignment="Center"
                                        Click="OnDeleteClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button Style="{StaticResource InkButton}"
                    Content="+ 添加课程"
                    DockPanel.Dock="Left"
                    Padding="18,8"
                    Click="OnAddClick" />
            <Button Style="{StaticResource GhostButton}"
                    Content="关闭"
                    DockPanel.Dock="Right"
                    Width="88"
                    Click="OnCloseClick" />
        </DockPanel>
    </Grid>
</Window>
