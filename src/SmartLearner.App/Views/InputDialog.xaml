<Window x:Class="SmartLearner.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="输入"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{DynamicResource BodyFont}"
        TextElement.Foreground="{DynamicResource InkBrush}">

    <StackPanel Margin="26,22,26,20">
        <TextBlock x:Name="LabelText"
                   Text="请输入名称"
                   FontSize="13"
                   Foreground="{DynamicResource SubtleBrush}" />

        <TextBox x:Name="InputBox"
                 Margin="0,14,0,0"
                 FontSize="14"
                 materialDesign:HintAssist.IsFloating="True" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Style="{StaticResource GhostButton}"
                    Content="取消"
                    Width="84"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource InkButton}"
                    Content="确定"
                    Width="88"
                    Margin="10,0,0,0"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
