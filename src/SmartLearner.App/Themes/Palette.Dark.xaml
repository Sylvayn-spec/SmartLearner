<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 夜读：墨底、暖白字、暗朱砂、月下苔绿 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#1D1A16" />
    <SolidColorBrush x:Key="CardBrush" Color="#282420" />
    <SolidColorBrush x:Key="InkBrush" Color="#EFE7DA" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#D6CCBD" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#A99C8B" />
    <SolidColorBrush x:Key="LineBrush" Color="#3A342C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C0604F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D4786A" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A94F40" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2A26" />
    <SolidColorBrush x:Key="MossBrush" Color="#93B184" />
    <SolidColorBrush x:Key="MossSoftBrush" Color="#2A3327" />
    <SolidColorBrush x:Key="GoldBrush" Color="#D9B85C" />
    <SolidColorBrush x:Key="JasmineBrush" Color="#FFFDF4" />

    <SolidColorBrush x:Key="ChromeBrush" Color="#E62A2620" />

    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D92E2923" Offset="0" />
        <GradientStop Color="#A625211C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#26FFFFFF" />

    <LinearGradientBrush x:Key="HeroWashBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF241F1A" Offset="0" />
        <GradientStop Color="#FF203026" Offset="0.62" />
        <GradientStop Color="#FF251F19" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowWashBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1C1916" Offset="0" />
        <GradientStop Color="#FF1E221C" Offset="0.55" />
        <GradientStop Color="#FF17140F" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="BodyFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="HeadingFont">SimSun, Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
