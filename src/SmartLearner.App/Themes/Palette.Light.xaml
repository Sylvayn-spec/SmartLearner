<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 宣纸 / 墨色 / 朱砂 / 窗边苔绿 / 茉莉金 -->
    <SolidColorBrush x:Key="PaperBrush" Color="#F6F0E4" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFCF6" />
    <SolidColorBrush x:Key="InkBrush" Color="#2C2620" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#4A423A" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#7C7060" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2D7C4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A23B2E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#BE5546" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#8C3226" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F1DED8" />
    <SolidColorBrush x:Key="MossBrush" Color="#6F8F63" />
    <SolidColorBrush x:Key="MossSoftBrush" Color="#E3ECDC" />
    <SolidColorBrush x:Key="GoldBrush" Color="#C9A227" />
    <SolidColorBrush x:Key="JasmineBrush" Color="#FFFDF4" />

    <!-- 顶栏与侧栏：半透明，让底纹透出来 -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#E8FFFCF6" />

    <!-- 玻璃：半透明奶白渐变 -->
    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFDF6" Offset="0" />
        <GradientStop Color="#B3F4EEE1" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#CCFFFFFF" />

    <!-- 首页主视觉底色 -->
    <LinearGradientBrush x:Key="HeroWashBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7F0E3" Offset="0" />
        <GradientStop Color="#FFE9F0E2" Offset="0.62" />
        <GradientStop Color="#FFF3EBDD" Offset="1" />
    </LinearGradientBrush>

    <!-- 全窗底色 -->
    <LinearGradientBrush x:Key="WindowWashBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8F2E7" Offset="0" />
        <GradientStop Color="#FFF2F0E2" Offset="0.55" />
        <GradientStop Color="#FFEDE7D8" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="BodyFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="HeadingFont">SimSun, Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
